# Backend runtime configuration

# Required only if you want live AEMET weather data in the API response.
AEMET_API_KEY=

# Optional GitHub token for authenticated release asset downloads.
# You can use either GITHUB_TOKEN or GH_TOKEN.
GITHUB_TOKEN=
GH_TOKEN=

# Optional logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Optional path to persistent processed data.
# If empty, the backend uses ./data/processed relative to the repo root.
DATA_DIR=

# Allowed frontend origin for CORS.
FRONTEND_ORIGIN=https://madridrefugio.es

# Comma-separated extra CORS origins.
ADDITIONAL_ALLOWED_ORIGINS=

# Set to 1 only to force a fresh download of release runtime assets.
FORCE_REFRESH_GRAPH_FROM_RELEASE=0
